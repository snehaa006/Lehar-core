# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database - Cloud SQL (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://lehar_user:password@localhost:5432/lehar_core_dev

# For Cloud SQL in production:
# DATABASE_URL=postgresql://username:password@/database?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Google Cloud
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=lehar-core-prod

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@leharcore.com

# Application URLs
FRONTEND_URL=http://localhost:8080

# Cloud Run (set automatically in production)
PORT=8080
